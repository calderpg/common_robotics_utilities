@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Eigen3)
if("@OpenMP_CXX_FOUND@")
  find_dependency(OpenMP)
endif()
find_dependency(rclcpp)
find_dependency(geometry_msgs)
find_dependency(visualization_msgs)
find_dependency(ZLIB)

include("${CMAKE_CURRENT_LIST_DIR}/common_robotics_utilitiesTargets.cmake")
check_required_components(common_robotics_utilities)

# The ROS 2 convention, which ament_target_dependencies() on Jazzy and older
# also reads.
set(common_robotics_utilities_TARGETS
    common_robotics_utilities::common_robotics_utilities)
